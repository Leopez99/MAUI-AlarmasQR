<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_AlarmasQR._View.CrearPisos"
             Title="Cliente">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- Título -->
            <Label Text="PISOS"
                   FontSize="26"
                   FontAttributes="Bold"/>

            <!-- Piso -->
            <Frame BorderColor="#CFCFCF"
                   CornerRadius="15"
                   Padding="15"
                   HasShadow="False">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Piso"
                           FontSize="18"
                           FontAttributes="Bold"/>

                    <!-- Botón para agregar Área/Alarma -->
                    <Frame WidthRequest="80"
                           HeightRequest="80"
                           BorderColor="#5A5AFF"
                           CornerRadius="12"
                           HasShadow="False"
                           Padding="0"
                           HorizontalOptions="Start">

                        <Button Text="+"
                                FontSize="34"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                CornerRadius="12"/>

                    </Frame>

                </VerticalStackLayout>

            </Frame>

            <!-- Botón para agregar un nuevo piso -->
            <Button Text="+"
                    FontSize="32"
                    HeightRequest="70"
                    BackgroundColor="Transparent"
                    BorderColor="#5A5AFF"
                    BorderWidth="2"
                    CornerRadius="15"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>