<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:MAUI_AlarmasQR._Model"
             x:Class="MAUI_AlarmasQR._View.CrearCliente"
             Title="Clientes">

    <Grid RowDefinitions="Auto,*"
          Padding="15"
          RowSpacing="10">

        <!-- Fila para crear un cliente nuevo -->
        <HorizontalStackLayout Grid.Row="0"
                               Spacing="10">

            <Entry
                Text="{Binding NombreCliente}"
                Placeholder="Nombre del cliente"
                WidthRequest="250"
                VerticalOptions="Center" />

            <Button
                Text="Agregar"
                Command="{Binding AgregarClienteCommand}" />

        </HorizontalStackLayout>

        <!-- Listado de clientes -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding ListaDeClientes}">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Cliente">

                    <Grid Padding="10">
                        <Label
                            Text="{Binding nombre}"
                            FontSize="18" />
                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>